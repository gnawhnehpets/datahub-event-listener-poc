# Copy to .env and fill in.
#
# Load it with (macOS / Linux / Git Bash on Windows):
#     set -a && . ./.env && set +a
#
# `set -a` matters: the pipeline YAMLs use ${VAR} substitution, and a variable
# present in .env but not EXPORTED fails the config load.
#
# PowerShell has no equivalent -- see the Windows section of README.md.


# No trailing slash. The listener strips one; raw curl does not, and you get
# //api/graphql and a 404.
DATAHUB_GMS_URL=https://[DATAHUB-SUBDOMAIN].trials.acryl.io

# PAT that can create domains. Settings > Access Tokens > Generate New Token.
DATAHUB_GMS_TOKEN=

# Where a failed event is written, and where the notifier's send-once markers
# live. Always set it explicitly: the config's fallback is ./.state, which works
# but puts state inside the repo.
#
# Set this even on Windows. A POSIX path like /tmp/failed-events does NOT error
# there -- Python resolves it against the current drive root and silently writes
# to C:\tmp\failed-events, so the send-once store ends up somewhere nobody
# checks. Since lookback_days replays a week of events on every restart, losing
# that store means duplicate emails rather than a visible failure.
#
#   macOS / Linux           FAILED_EVENTS_DIR=/tmp/failed-events
#   Windows (Git Bash)      FAILED_EVENTS_DIR=/c/Users/<you>/AppData/Local/Temp/failed-events
#   Windows (PowerShell)    FAILED_EVENTS_DIR=C:/Users/<you>/AppData/Local/Temp/failed-events
#
# Forward slashes are fine on Windows; backslashes in a .env are not, because
# the loader treats them as escapes.
FAILED_EVENTS_DIR=/tmp/failed-events

# The listener package lives in src/. Without this the action type
# actions.router:WorkflowRouterAction cannot be imported and the
# pipeline fails to instantiate. Relative, so run from the repo root.
PYTHONPATH=src
CONSUMER_ID=approval-actions-demo

# REQUIRED when a workflow routes `rejected: notify_rejection`, which the
# shipped action-route-workflow-decisions.yaml does for Propose New Domain.
# Grab a free API key at https://resend.com and paste it here.
# Route that outcome to `log` instead and this is not needed at all -- DataHub
# Cloud still notifies the requester natively; you lose only the rejection
# reason and the submitted values.
#
# The pipeline refuses to start if the routing needs this and it is blank,
# rather than failing on the first real rejection. 
RESEND_API_KEY=
